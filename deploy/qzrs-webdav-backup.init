#!/bin/sh /etc/rc.common
#
# qzrs-webdav-backup — OpenWrt procd service
#
# Install to /etc/init.d/qzrs-webdav-backup and enable with:
#     /etc/init.d/qzrs-webdav-backup enable
#     /etc/init.d/qzrs-webdav-backup start
#
# Optional UCI overrides live in /etc/config/qzrs-webdav-backup:
#     config qzrs-webdav-backup 'main'
#         option enabled  '1'
#         option data_dir '/etc/qzrs-webdav-backup'
#         option listen   '0.0.0.0:8787'
#         option log_file '/etc/qzrs-webdav-backup/service.log'
#         option log_max_kb '2048'

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/qzrs-webdav-backup
UCI_NAME=qzrs-webdav-backup
LOG_SECTION=main

DEFAULT_DATA_DIR=/etc/qzrs-webdav-backup
DEFAULT_LISTEN=0.0.0.0:8787

# Filled in by load_config().
DATA_DIR=""
LISTEN=""
LOG_FILE=""
LOG_MAX_KB=2048
ENABLED=1

load_config() {
    DATA_DIR="$DEFAULT_DATA_DIR"
    LISTEN=""
    LOG_FILE=""
    LOG_MAX_KB=2048
    ENABLED=1

    config_load "$UCI_NAME"

    config_get ENABLED "$LOG_SECTION" enabled 1
    config_get DATA_DIR "$LOG_SECTION" data_dir "$DEFAULT_DATA_DIR"
    config_get LISTEN "$LOG_SECTION" listen ""
    config_get LOG_FILE "$LOG_SECTION" log_file ""
    config_get LOG_MAX_KB "$LOG_SECTION" log_max_kb 2048

    [ -n "$DATA_DIR" ] || DATA_DIR="$DEFAULT_DATA_DIR"
    [ -n "$LOG_FILE" ] || LOG_FILE="$DATA_DIR/service.log"
}

# rotate_log keeps the previous generation so the log cannot grow without bound
# on a device whose overlay partition is small.
rotate_log() {
    [ -f "$LOG_FILE" ] || return 0

    size_kb=$(du -k "$LOG_FILE" 2>/dev/null | awk '{print $1}')
    [ -n "$size_kb" ] || size_kb=0
    if [ "$size_kb" -gt "$LOG_MAX_KB" ] 2>/dev/null; then
        mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
        : > "$LOG_FILE" 2>/dev/null
    fi
    return 0
}

start_service() {
    load_config

    if [ "$ENABLED" != "1" ]; then
        logger -t qzrs-webdav-backup "service is disabled in /etc/config/$UCI_NAME"
        return 0
    fi

    if [ ! -x "$PROG" ]; then
        logger -t qzrs-webdav-backup "binary $PROG is missing; cannot start"
        return 1
    fi

    mkdir -p "$DATA_DIR"
    chmod 700 "$DATA_DIR" 2>/dev/null

    rotate_log
    touch "$LOG_FILE" 2>/dev/null

    procd_open_instance main
    procd_set_param command "$PROG" -data "$DATA_DIR"

    # An explicit listen override wins over the value in config.json, which
    # lets an operator move the port without editing the JSON by hand.
    [ -n "$LISTEN" ] && procd_append_param command -listen "$LISTEN"
    [ -n "$LOG_FILE" ] && procd_append_param command -log-file "$LOG_FILE"

    # Restart on crash, but stop trying if it fails repeatedly: a boot loop on a
    # router is worse than a service that stays down.
    procd_set_param respawn 3600 5 5

    procd_set_param stdout 1
    procd_set_param stderr 1

    # The archive build is memory-hungry for large trees; keep the process from
    # taking the whole router down if something goes wrong.
    procd_set_param limits core="0"

    procd_close_instance
}

stop_service() {
    logger -t qzrs-webdav-backup "stopping"
}

reload_service() {
    load_config
    logger -t qzrs-webdav-backup "reloading"
    stop
    start
}

status_service() {
    load_config
    echo "data_dir : $DATA_DIR"
    echo "listen   : ${LISTEN:-<from config.json>}"
    echo "log_file : $LOG_FILE"
    if [ -f "$DATA_DIR/config.json" ]; then
        echo "config   : present"
    else
        echo "config   : not created yet (first run will initialise it)"
    fi
}

service_triggers() {
    procd_add_reload_trigger "$UCI_NAME"
}
