# ---- 构建产物 ----
# 二进制体积较大，通过 Release 分发，不入库
dist/
*.tar.gz

# ---- 脚本运行输出 ----
# 这些文件包含设备地址、初始登录密码与运行日志，绝不入库
scripts/out*.txt
scripts/console*.txt
scripts/build_out.txt
scripts/fill.txt
scripts/pw_repro.txt

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 临时目录 ----
.tmp/
.tmp2/

# ---- Playwright CLI 本地安装与浏览器配置 ----
.pwcli/
.playwright-cli/

# ---- 本地运行数据 ----
devdata/

# ---- 编辑器 / 系统 ----
*.swp
*~
.DS_Store
Thumbs.db

# ---- 本地调试临时文件 ----
.tmp_cookies.txt
.tmp_token.txt
.pw_*
.tmp_config.json
